// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum QuoteStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum PaymentMethod {
  STRIPE
  BANK_TRANSFER
  PAY_LATER
  QUOTE_REQUEST
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIAL
  REFUNDED
}

enum ServiceType {
  FINE_ART
  LUXURY_FURNITURE
  MUSEUM_DELIVERY
  WHITE_GLOVE
  PACKING
  INSTALLATION
  STORAGE
}

enum BuildingType {
  HOUSE
  APARTMENT
  CONDO
  OFFICE
  MUSEUM
  GALLERY
  WAREHOUSE
  OTHER
}

enum TimeSlot {
  MORNING
  AFTERNOON
  EVENING
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  phone         String?
  role          UserRole  @default(CUSTOMER)
  avatarUrl     String?
  supabaseId    String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer      Customer?
  staff         Staff?
  notifications Notification[]
}

model Customer {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company       String?
  address       String?
  city          String?
  state         String?
  zip           String?
  country       String    @default("US")
  notes         String?
  totalBookings Int       @default(0)
  totalSpent    Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings      Booking[]
  quotes        Quote[]
  invoices      Invoice[]
}

model Service {
  id          String      @id @default(cuid())
  name        String
  type        ServiceType
  description String
  basePrice   Float
  icon        String?
  active      Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  bookings    Booking[]
}

model PricingRule {
  id          String   @id @default(cuid())
  name        String
  description String?
  ruleKey     String   @unique
  value       Float
  unit        String   @default("flat")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Booking {
  id              String        @id @default(cuid())
  bookingNumber   String        @unique
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id])
  status          BookingStatus @default(PENDING)
  paymentMethod   PaymentMethod @default(PAY_LATER)
  paymentStatus   PaymentStatus @default(UNPAID)

  // Pickup
  pickupAddress   String
  pickupCity      String
  pickupState     String
  pickupZip       String
  pickupBuilding  BuildingType  @default(HOUSE)
  pickupFloor     Int           @default(1)
  pickupElevator  Boolean       @default(false)
  pickupDock      Boolean       @default(false)

  // Destination
  destAddress     String
  destCity        String
  destState       String
  destZip         String
  destBuilding    BuildingType  @default(HOUSE)
  destFloor       Int           @default(1)
  destElevator    Boolean       @default(false)
  destDock        Boolean       @default(false)

  // Schedule
  scheduledDate   DateTime
  timeSlot        TimeSlot      @default(MORNING)
  estimatedHours  Float         @default(2)

  // Pricing
  basePrice       Float
  distanceFee     Float         @default(0)
  addOnFees       Float         @default(0)
  discount        Float         @default(0)
  totalPrice      Float
  couponCode      String?

  // Staff
  staffId         String?
  staff           Staff?        @relation(fields: [staffId], references: [id])

  notes           String?
  internalNotes   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           BookingItem[]
  invoice         Invoice?
  notifications   Notification[]
}

model BookingItem {
  id              String   @id @default(cuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  category        String
  title           String
  description     String?
  width           Float?
  height          Float?
  length          Float?
  weight          Float?
  quantity        Int      @default(1)
  hasFrame        Boolean  @default(false)
  hasGlass        Boolean  @default(false)
  isFragile       Boolean  @default(false)
  needsInsurance  Boolean  @default(false)
  needsPacking    Boolean  @default(false)
  needsUnpacking  Boolean  @default(false)
  needsInstall    Boolean  @default(false)
  needsDisassembly Boolean @default(false)
  needsAssembly   Boolean  @default(false)
  insuranceValue  Float?
  photoUrls       String[]
  notes           String?
  createdAt       DateTime @default(now())
}

model Quote {
  id            String      @id @default(cuid())
  quoteNumber   String      @unique
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  status        QuoteStatus @default(PENDING)
  serviceType   String
  description   String
  estimatedPrice Float
  validUntil    DateTime
  notes         String?
  adminNotes    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  bookingId     String        @unique
  booking       Booking       @relation(fields: [bookingId], references: [id])
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  amount        Float
  tax           Float         @default(0)
  total         Float
  status        PaymentStatus @default(UNPAID)
  dueDate       DateTime
  paidAt        DateTime?
  pdfUrl        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model CalendarSlot {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  timeSlot    TimeSlot
  capacity    Int      @default(3)
  booked      Int      @default(0)
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([date, timeSlot])
}

model Staff {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?
  department  String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookings    Booking[]
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id])
  title       String
  message     String
  read        Boolean  @default(false)
  type        String   @default("info")
  createdAt   DateTime @default(now())
}

model Analytics {
  id          String   @id @default(cuid())
  date        DateTime @db.Date @unique
  revenue     Float    @default(0)
  bookings    Int      @default(0)
  newCustomers Int     @default(0)
  completedJobs Int    @default(0)
  avgBookingValue Float @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Settings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
